# VALTORIX BD OS - Environment Configuration
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to Git. It contains secrets.

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_NAME="VALTORIX BD OS"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Supabase (Phase 1 - Database & Auth)
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ============================================================
# AI Provider (Phase 3 - Local AI via Ollama)
# ============================================================
# AI_PROVIDER=mock
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ============================================================
# Email Provider (Phase 5 - Optional, future)
# ============================================================
# EMAIL_PROVIDER=mock
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
